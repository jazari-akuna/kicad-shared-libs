(footprint "DFE201612E" (version 20241229) (generator "codex") (layer "F.Cu")
(descr "Murata DFE201612E: datasheet PCB lands, body2.0x1.6mm; unpolarized. Simplified maximum-height model.")
(attr smd)
(fp_text reference "REF**" (at 0 -1.6) (layer "F.SilkS") (effects (font (size 0.6 0.6) (thickness 0.1))))
(fp_text value "DFE201612E" (at 0 1.6) (layer "F.Fab") (effects (font (size 0.5 0.5) (thickness 0.1))))
(fp_text user "${REFERENCE}" (at 0 -1.6) (layer "F.Fab") (effects (font (size 0.6 0.6) (thickness 0.1))))
(pad "1" smd rect (at -0.8 0) (size 0.8 1.8) (layers "F.Cu" "F.Paste" "F.Mask"))
(pad "2" smd rect (at 0.8 0) (size 0.8 1.8) (layers "F.Cu" "F.Paste" "F.Mask"))
(fp_rect (start -1 -0.8) (end 1 0.8) (stroke (width 0.05) (type default)) (fill none) (layer "F.Fab"))
(fp_rect (start -1.45 -1.15) (end 1.45 1.15) (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))
(fp_line (start -0.3 -0.95) (end 0.3 -0.95) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
(fp_line (start -0.3 0.95) (end 0.3 0.95) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
(model "${KSL_ROOT}/Inductor_KSL/Inductor_KSL.3dshapes/DFE201612E.step" (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
