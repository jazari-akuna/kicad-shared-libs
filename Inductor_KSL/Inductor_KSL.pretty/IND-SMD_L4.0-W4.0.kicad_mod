(module "IND-SMD_L4.0-W4.0" (layer F.Cu) (tedit 6A6604A2)
  (descr "cjiang FHD4020S molded power inductor 4.0x4.0x2.0mm. Land pattern per datasheet Fig.2 (G=3.7 pad width, H=1.9 gap, I=1.10 pad length). Source: JLC/EasyEDA C602029, pads corrected to datasheet.")
  (tags "IND-SMD_L4.0-W4.0 footprint C602029")
  (attr smd)
  (fp_text reference REF** (at 0 -3.1) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value IND-SMD_L4.0-W4.0 (at 0 3.1) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_circle (center -2 2) (end -1.97 2) (layer Cmts.User) (width 0.06))
  (fp_line (start -2.15 -2.15) (end 2.15 -2.15) (layer F.SilkS) (width 0.15))
  (fp_line (start -2.15 2.15) (end 2.15 2.15) (layer F.SilkS) (width 0.15))
  (fp_rect (start -2.3 -2.3) (end 2.3 2.3) (stroke (width 0.05) (type solid)) (fill no) (layer F.CrtYd))

  (pad 1 smd rect (at -1.5 0) (size 1.1 3.7) (layers F.Cu F.Mask F.Paste))
  (pad 2 smd rect (at 1.5 0) (size 1.1 3.7) (layers F.Cu F.Mask F.Paste))
  (fp_poly (pts (xy -2 2) (xy -2 -2) (xy 2 -2) (xy 2 2)) (layer Cmts.User) (width 0.15))
  (fp_poly (pts (xy 1.05 -1.55) (xy 2 -1.55) (xy 2 1.55) (xy 1.05 1.55)) (layer Cmts.User) (width 0.15))
  (fp_poly (pts (xy -2 -1.55) (xy -1.05 -1.55) (xy -1.05 1.55) (xy -2 1.55)) (layer Cmts.User) (width 0.15))
  (fp_text user ${REFERENCE} (at 0 0) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (model ${KSL_ROOT}/Inductor_KSL/Inductor_KSL.3dshapes/IND-SMD_L4.0-W4.0.step
    (at (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )
)
