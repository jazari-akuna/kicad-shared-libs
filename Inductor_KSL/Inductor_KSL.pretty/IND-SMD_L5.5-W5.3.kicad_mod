(module "IND-SMD_L5.5-W5.3" (layer F.Cu) (tedit 6A660E2A)
  (descr "cjiang FEXL0530A molded power inductor, body A=5.5 x B=5.3 x C=2.9mm. Land pattern per datasheet 'Recommend Land Pattern' (H=4.7 pad width, L=4.5 total span, G=2.0 gap). Gap axis (B=5.3) laid along X, pad-width axis (A=5.5) along Y, matching the other IND-SMD_* footprints. Source: JLC/EasyEDA C5378511, pads corrected to datasheet.")
  (tags "IND-SMD_L5.5-W5.3 footprint C5378511")
  (attr smd)
  (fp_text reference REF** (at 0 -3.8) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value IND-SMD_L5.5-W5.3 (at 0 3.8) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_circle (center -2.65 2.75) (end -2.62 2.75) (layer Cmts.User) (width 0.06))
  (fp_line (start -2.85 -2.85) (end 2.85 -2.85) (layer F.SilkS) (width 0.15))
  (fp_line (start -2.85 2.85) (end 2.85 2.85) (layer F.SilkS) (width 0.15))
  (fp_rect (start -3 -3) (end 3 3) (stroke (width 0.05) (type solid)) (fill no) (layer F.CrtYd))

  (pad 1 smd rect (at -1.625 0) (size 1.25 4.7) (layers F.Cu F.Mask F.Paste))
  (pad 2 smd rect (at 1.625 0) (size 1.25 4.7) (layers F.Cu F.Mask F.Paste))
  (fp_poly (pts (xy -2.65 2.75) (xy -2.65 -2.75) (xy 2.65 -2.75) (xy 2.65 2.75)) (layer Cmts.User) (width 0.15))
  (fp_poly (pts (xy 1.15 -2.15) (xy 2.25 -2.15) (xy 2.25 2.15) (xy 1.15 2.15)) (layer Cmts.User) (width 0.15))
  (fp_poly (pts (xy -2.25 -2.15) (xy -1.15 -2.15) (xy -1.15 2.15) (xy -2.25 2.15)) (layer Cmts.User) (width 0.15))
  (fp_text user ${REFERENCE} (at 0 0) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (model ${KSL_ROOT}/Inductor_KSL/Inductor_KSL.3dshapes/IND-SMD_L5.5-W5.3.step
    (at (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )
)
