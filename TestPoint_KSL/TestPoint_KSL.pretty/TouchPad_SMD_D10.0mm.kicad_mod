(footprint "TouchPad_SMD_D10.0mm" (version 20211014) (generator pcbnew)
  (layer "F.Cu")
  (descr "Capacitive touch electrode, 10mm circular copper pad, covered by soldermask (no mask opening, no paste), per Espressif touch design guidelines")
  (tags "touch electrode capacitive pad")
  (attr smd exclude_from_pos_files)
  (fp_text reference "REF**" (at 0 -6.2) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "TouchPad_SMD_D10.0mm" (at 0 6.2) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_circle (center 0 0) (end 5.25 0) (layer "F.CrtYd") (stroke (width 0.05) (type solid)) (fill none))
  (fp_circle (center 0 0) (end 5 0) (layer "F.Fab") (stroke (width 0.1) (type solid)) (fill none))
  (pad "1" smd circle (at 0 0) (size 10 10) (layers "F.Cu"))
)
