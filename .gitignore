# For PCBs designed using KiCad: http://www.kicad-pcb.org/
# Format documentation: http://kicad-pcb.org/help/file-formats/

# macOS Finder metadata - never belongs in the library
.DS_Store

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml
*.csv

# NDA-derived parts used to be gitignored here. They now live in their own
# private repository, kicad-nda-libs, addressed by the ${KNL_ROOT} path
# variable. Nothing NDA belongs in this repo.

# the vendor' SENSOR-FAMILY product specification forbids reproduction and
# disclosure to unauthorised persons, and FPC do not publish it. It lives in
# ${KNL_ROOT}/datasheets/. Without this entry scripts/datasheets.py would
# re-fetch it from the source URL still recorded in datasheets/.state.json
# and .gitattributes would commit it to LFS on a repo with a public remote.
datasheets/SENSOR-A.pdf

# Transient working state of scripts/datasheets.py (.state.json IS tracked -
# it is the audit record of every language/document judgement).
datasheets/.queue.json
