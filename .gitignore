# For PCBs designed using KiCad: http://www.kicad-pcb.org/
# Format documentation: http://kicad-pcb.org/help/file-formats/

# macOS Finder metadata - never belongs in the library
.DS_Store

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml
*.csv

# Parts whose documentation is under NDA live in a separate private library
# under ${KNL_ROOT}, never here. The specific documents are named in that
# repository's denylist and in .git/info/exclude, not in this tracked file: a
# list of what must not be published is itself a disclosure.

# Bookkeeping for the datasheet tooling. Not a part, so not tracked here.
datasheets/.queue.json
datasheets/.state.json
