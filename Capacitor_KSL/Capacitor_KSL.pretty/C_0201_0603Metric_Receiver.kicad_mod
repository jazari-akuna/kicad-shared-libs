(footprint "C_0201_0603Metric_Receiver" (version 20241229) (generator "pcbnew") (layer "F.Cu")
 (descr "0201 receiver capacitor. Reflow lands a=0.20,b=0.30,c=0.32mm within Murata GRM03 and Samsung0603 recommendations. JLC download corrected: oversize lands and duplicate paste removed; model Z seating corrected. Assembly qualification on flex remains required.")
 (attr smd)
 (property "Reference" "REF**" (at 0 -0.7) (layer "F.SilkS") (effects (font (size .5 .5) (thickness .08))))
 (property "Value" "C_0201_0603Metric_Receiver" (at 0 .7) (layer "F.Fab") (effects (font (size .3 .3) (thickness .05))))
 (fp_rect (start -.3 -.15) (end .3 .15) (stroke (width .05) (type solid)) (fill none) (layer "F.Fab"))
 (fp_rect (start -.475 -.25) (end .475 .25) (stroke (width .05) (type solid)) (fill none) (layer "F.CrtYd"))
 (fp_text user "${REFERENCE}" (at 0 0) (layer "F.Fab") (effects (font (size .2 .2) (thickness .03))))
 (pad "1" smd rect (at -.25 0) (size .30 .32) (layers "F.Cu" "F.Paste" "F.Mask"))
 (pad "2" smd rect (at .25 0) (size .30 .32) (layers "F.Cu" "F.Paste" "F.Mask"))
 (model "${KSL_ROOT}/Capacitor_KSL/Capacitor_KSL.3dshapes/C_0201_0603Metric_Receiver.step" (offset (xyz 0 0 .15)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
